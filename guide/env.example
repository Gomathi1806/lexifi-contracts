# Lexifi pilot pool — copy to .env and fill in. Never commit the real file.

# OPTIONAL. Prefer --ledger or --account (see the guide) and leave this unset.
PRIVATE_KEY=0x...

# Base mainnet RPC
RPC_URL=https://mainnet.base.org

# --- the pool ---
# currency0 must sort numerically below currency1. Native ETH is the zero address.
# Example: your token against USDC (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
FEE=3000
TICK_SPACING=60
# 1:1 starting price. Use your real price for a live pool.
SQRT_PRICE_X96=79228162514264337593543950336

# Set true if the pool already exists and you only want to attach a policy.
SKIP_INITIALIZE=false

# --- the rules ---
# "regional" = jurisdiction rules, "threshold" = rules by trade size
POLICY=regional

# Access levels: 0 DENIED, 1 RETAIL, 2 ACCREDITED, 3 INSTITUTIONAL

# regional only
REQUIRE_COUNTRY=true
REQUIRE_ACCOUNT=false
MIN_SWAP_LEVEL=2
MIN_LP_LEVEL=2

# threshold only (amounts in wei)
NO_KYC_LIMIT=100000000000000
ENHANCED_LIMIT=1000000000000000000
